<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AETHELGARD // ELITE_INFRASTRUCTURE</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@900&family=Space+Grotesk:wght@300;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #0a0a0c; color: #ffffff; margin: 0; overflow-x: hidden; font-family: 'Space+Grotesk', sans-serif; }
        
        /* The Interactive Bubble Layer */
        .mesh-bg { 
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; 
            background: radial-gradient(circle at 50% 50%, rgba(52, 73, 255, 0.15) 0%, transparent 50%);
        }

        .glass-card { 
            background: rgba(255, 255, 255, 0.03); 
            backdrop-filter: blur(12px); 
            border: 1px solid rgba(255, 255, 255, 0.1); 
            border-radius: 24px; 
            transition: 0.5s ease;
        }

        /* The Animation Fix: Items start visible so NO black screen */
        .reveal { opacity: 1; transform: translateY(0); transition: 1s ease; }

        @media (min-width: 768px) {
            .reveal { opacity: 0; transform: translateY(30px); }
            .reveal.active { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body>

    <div class="mesh-bg" id="glow"></div>
    
    <nav class="fixed top-0 w-full z-50 px-6 py-8 flex justify-between items-center backdrop-blur-sm border-b border-white/5">
        <div class="font-black text-xl tracking-tighter uppercase" style="font-family: 'Outfit';">AETHELGARD</div>
        <a href="index.html" class="text-[10px] uppercase tracking-widest text-zinc-400 font-bold border border-zinc-800 px-4 py-2 rounded-full hover:text-white transition-all">Exit_Vault</a>
    </nav>

    <main class="relative z-10">
        <section class="min-h-screen flex flex-col items-center justify-center px-6">
            <div class="reveal text-center max-w-4xl" id="main-content">
                <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-card mb-8 border-blue-500/20">
                    <span class="w-2 h-2 rounded-full bg-blue-500 animate-pulse"></span>
                    <span class="text-[10px] font-bold uppercase tracking-[0.3em] text-blue-300">System_Authenticated</span>
                </div>
                <h1 class="text-7xl md:text-9xl font-black mb-8 leading-[0.85] tracking-tighter uppercase" style="font-family: 'Outfit';">
                    Elite<br><span class="text-blue-600">Portal</span>
                </h1>
                <p class="text-lg md:text-xl text-zinc-400 max-w-2xl mx-auto font-light">
                    Independent infrastructure node. Secure audio distribution and private project blueprints finalized.
                </p>
            </div>
        </section>

        <section class="py-32 px-6 max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">
            <div class="reveal glass-card p-12 h-80 flex flex-col justify-end group hover:bg-white/5">
                <h3 class="text-3xl font-bold mb-4 uppercase" style="font-family: 'Outfit';">Owned</h3>
                <p class="text-zinc-500 text-sm">100% control over distribution nodes and audio masters.</p>
            </div>
            <div class="reveal glass-card p-12 h-80 flex flex-col justify-end group hover:bg-white/5">
                <h3 class="text-3xl font-bold mb-4 uppercase" style="font-family: 'Outfit';">Independent</h3>
                <p class="text-zinc-500 text-sm">Built from the ground up. Zero third-party dependencies.</p>
            </div>
            <div class="reveal glass-card p-12 h-80 flex flex-col justify-end group hover:bg-white/5">
                <h3 class="text-3xl font-bold mb-4 uppercase" style="font-family: 'Outfit';">Secure</h3>
                <p class="text-zinc-500 text-sm">Encrypted asset vaults and satellite uplink confirmation.</p>
            </div>
        </section>
    </main>

    <script>
        // Force the animations to run immediately
        window.onload = () => {
            setTimeout(() => {
                document.querySelectorAll('.reveal').forEach(el => el.classList.add('active'));
            }, 100);
        };

        // Mouse Bubble Effect
        document.addEventListener('mousemove', (e) => {
            const glow = document.getElementById('glow');
            const x = (e.clientX / window.innerWidth) * 100;
            const y = (e.clientY / window.innerHeight) * 100;
            glow.style.background = `radial-gradient(circle at ${x}% ${y}%, rgba(52, 73, 255, 0.25) 0%, transparent 40%)`;
        });
    </script>
</body>
</html>
